<!DOCTYPE html>
<html>
<head>
  <style>
    /* Base styles */
    body {
      background-color: black;
      color: white;
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
      line-height: 1.5;
    }

    /* Container */
    .project-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* Navigation */
    .back-link {
      display: inline-flex;
      align-items: center;
      color: white;
      text-decoration: none;
      margin-bottom: 2rem;
      font-size: 0.875rem;
      transition: color 0.3s;
    }

    .back-link:hover {
      color: #9ca3af;
    }

    /* Project header */
    .project-header {
      margin-bottom: 4rem;
    }

    .project-title {
      font-size: 3.75rem;
      font-weight: bold;
      margin: 0 0 1rem 0;
    }

    .project-overview {
      font-size: 1.25rem;
      color: #9ca3af;
      margin-bottom: 2rem;
      max-width: 65ch;
    }

    /* What I Did section - adjusted padding */
    .what-i-did {
      background-color: #1a1a1a;
      border-radius: 1rem;
      padding: 0.5rem 2rem 2rem 2rem;  /* Reduced top padding only */
      margin-bottom: 4rem;
    }

    .what-i-did h2 {
      font-size: 1.5rem;
      margin: 0 0 1.5rem 0;
      color: #f97316;
    }

    .what-i-did ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .what-i-did li {
      background-color: #262626;
      padding: 1rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
    }

    /* Project content */
    .project-content {
      color: #e5e7eb;
    }

    .project-content h2 {
      font-size: 2rem;
      margin: 3rem 0 1.5rem 0;
      color: #f97316;
    }

    .project-content h3 {
      font-size: 1.5rem;
      margin: 2rem 0 1rem 0;
      color: white;
    }

    .project-content p {
      color: #9ca3af;
      margin-bottom: 1.5rem;
      max-width: 65ch;
    }

    .project-content img {
      max-width: 100%;
      height: auto;
      border-radius: 0.5rem;
      margin: 2rem 0;
    }

    /* Results section */
    .results-section {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid #333;
    }

/* Updated Laptop Mockup Styles */
/* Updated CSS */
.laptop-wrapper {
  width: 800px; /* Set exact width */
  margin: 40px auto;
  padding: 20px;
  background: transparent;
}

.laptop {
  background: #2a2a2a;
  border-radius: 18px;
  border: 2px solid #444;
  padding: 20px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.3);
  width: 100%;
  box-sizing: border-box; /* Add this to include padding in width calculation */
}

.laptop-screen {
  background: white;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
  height: 500px;
  width: 800px; /* Set exact width */
  width: 100%; /* Change to 100% to stay within laptop */
  margin: 0 auto;
  box-sizing: border-box; /* Add this */
}

.laptop-screen img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover; /* This will ensure image covers the area without stretching */
}

.laptop-base {
  background: #333;
  height: 20px;
  margin: 0 auto;
  margin-top: -2px;
  border-radius: 0 0 20px 20px;
  width: 80%;
  position: relative;
}

.phone-wrapper {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  max-width: 1200px;
  margin: 40px auto;
  padding: 20px;
  /* No background color specified - will use your existing black background */
}

.phone-mockup {
  background: #000;
  border-radius: 40px;
  padding: 0px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.5); /* Deepened shadow for dark theme */
  position: relative;
}

/* iPhone notch */
.phone-mockup::before {
  content: '';
  position: absolute;
  width: 50%;
  height: 20px;
  background: #000;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 0 0 12px 12px;
  z-index: 2;
}

.phone-screen {
  background: white;
  border-radius: 30px;
  overflow: hidden;
  aspect-ratio: 9/19.5; /* iPhone aspect ratio */
}

.phone-screen img {
  width: 100%;
  height: 120%;
  object-fit: cover;
  display: block;
}
  </style>
</head>
<body>
  <div class="project-container">
    <a href="/creative-portfolio" class="back-link">
      ← Back to Portfolio
    </a>

    <article class="project-content">
      <header class="project-header">
        <h1 class="project-title">{{ page.title }}</h1>
        <p class="project-overview">{{ page.summary }}</p>
        
        <div class="what-i-did">
          <h2>My Contributions</h2>
          <ul>
            {% for item in page['What I Do'] %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      </header>
      
      {{ content }}
      
      {% if page.results %}
        <section class="results-section">
          <h2>Results</h2>
          {{ page.results | markdownify }}
        </section>
      {% endif %}
    </article>
  </div>
</body>
</html>